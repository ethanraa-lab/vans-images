# Local configuration. Never commit .env or real credentials.
TEAM_USERNAME=
# Run npm run hash-password; paste only the resulting scrypt hash here.
TEAM_PASSWORD_HASH=
BRAVE_SEARCH_API_KEY=
PORT=3000
# Must exactly match the URL used to open the app, including scheme and port.
APP_ORIGIN=http://localhost:3000
# Hosting: NODE_ENV=production, HOST=0.0.0.0, APP_ORIGIN=https://your-hostname
